stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group1 fill:#d5f5e3,stroke:#6b7b72,color:#1b2631
  classDef group1Fixed fill:#d5f5e3,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group2 fill:#fdebd0,stroke:#7f7668,color:#1b2631
  classDef group2Fixed fill:#fdebd0,stroke:#1e8449,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Waiting to check" as legendGroup0
    state "Both new minutes are kept" as legendGroup1
    state "A minute was skipped" as legendGroup2
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendGroup2 group2
  class legendFixed plainFixed
  state "After the check" as g0 {
    state "6:31 finished, 6:32<br/>finished, 6:33 finished" as s0
    state "6:31 finished, 6:32<br/>finished, 6:33 running" as s1
    state "6:31 finished, 6:32<br/>running, 6:33 waiting its<br/>turn" as s2
    state "6:31 finished, 6:32<br/>skipped, 6:33 finished" as s3
    state "6:31 finished, 6:32<br/>skipped, 6:33 running" as s4
    state "6:31 running, 6:32<br/>skipped, 6:33 waiting its<br/>turn" as s5
    state "6:31 running, 6:32 waiting<br/>its turn, 6:33 waiting its<br/>turn" as s6
  }
  state "Before the check" as g1 {
    state "6:31 finished, 6:32 still<br/>due, 6:33 still due" as s7
    state "6:31 running, 6:32 still<br/>due, 6:33 still due" as s8
  }
  [*] --> s8
  s8 --> s5 : the check skips 6:32
  s8 --> s7 : the running job finishes
  s5 --> s4 : the running job finishes
  s4 --> s3 : the running job finishes
  s8 --> s6 : with the fix, the check queues<br/>6:32 and 6:33
  s6 --> s2 : with the fix, the running job<br/>finishes
  s2 --> s1 : with the fix, the running job<br/>finishes
  s1 --> s0 : with the fix, the running job<br/>finishes
  class s0 group1Fixed
  class s1 group1Fixed
  class s2 group1Fixed
  class s3 group2Fixed
  class s4 group2Fixed
  class s5 group2Fixed
  class s6 group1Fixed
  class s7 group0

---
title: "A block that finishes during the timeout grace"
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group0Fixed fill:#d6eaf8,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group1 fill:#d5f5e3,stroke:#6b7b72,color:#1b2631
  classDef group1Fixed fill:#d5f5e3,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group2 fill:#f5b7b1,stroke:#7b5c59,color:#1b2631
  classDef group2Fixed fill:#f5b7b1,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group3 fill:#fdebd0,stroke:#7f7668,color:#1b2631
  classDef group3Fixed fill:#fdebd0,stroke:#1e8449,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Still trying" as legendGroup0
    state "Success kept" as legendGroup1
    state "Success discarded" as legendGroup2
    state "Run failed" as legendGroup3
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendGroup2 group2
  class legendGroup3 group3
  class legendFixed plainFixed
  state "Block did not finish in<br/>time" as g0 {
    state "attempt 1 in the grace<br/>period" as s0
    state "attempt 2 in the grace<br/>period" as s1
    state "attempt 3 in the grace<br/>period" as s2
    state "failed" as s3
  }
  state "Block in progress" as g1 {
    state "attempt 1 running" as s4
    state "attempt 2 running" as s5
    state "attempt 3 running" as s6
  }
  state "Block raised an error" as g2 {
    state "attempt 1 in the grace<br/>period" as s7
    state "attempt 2 in the grace<br/>period" as s8
    state "attempt 3 in the grace<br/>period" as s9
    state "failed" as s10
  }
  state "Block returned a value" as g3 {
    state "attempt 1 returned during<br/>the grace period" as s11
    state "attempt 2 in the grace<br/>period" as s12
    state "attempt 2 returned during<br/>the grace period" as s13
    state "attempt 2 running" as s14
    state "attempt 3 in the grace<br/>period" as s15
    state "attempt 3 returned during<br/>the grace period" as s16
    state "attempt 3 running" as s17
    state "failed" as s18
    state "kept as success" as s19
  }
  [*] --> s4
  s4 --> s11 : the block returns a value<br/>during the grace period
  s4 --> s0 : the grace period ends with the<br/>block still going
  s4 --> s7 : the block raises an error
  s11 --> s14 : the engine throws that result<br/>away
  s0 --> s5 : the engine tries again
  s7 --> s5 : the engine tries again
  s14 --> s13 : the block returns a value<br/>during the grace period
  s14 --> s12 : the grace period ends with the<br/>block still going or the block<br/>raises an error
  s5 --> s13 : the block returns a value<br/>during the grace period
  s5 --> s1 : the grace period ends with the<br/>block still going
  s5 --> s8 : the block raises an error
  s13 --> s17 : the engine throws that result<br/>away
  s12 --> s17 : the engine tries again
  s1 --> s6 : the engine tries again
  s8 --> s6 : the engine tries again
  s17 --> s16 : the block returns a value<br/>during the grace period
  s17 --> s15 : the grace period ends with the<br/>block still going or the block<br/>raises an error
  s6 --> s16 : the block returns a value<br/>during the grace period
  s6 --> s2 : the grace period ends with the<br/>block still going
  s6 --> s9 : the block raises an error
  s16 --> s18 : the engine throws that result<br/>away
  s15 --> s18 : the last attempt fails
  s2 --> s3 : the last attempt fails
  s9 --> s10 : the last attempt fails
  s11 --> s19 : with the fix, the engine keeps<br/>that result
  s13 --> s19 : with the fix, the engine keeps<br/>that result
  s16 --> s19 : with the fix, the engine keeps<br/>that result
  class s0 group0
  class s1 group0
  class s2 group0
  class s3 group3
  class s4 group0
  class s5 group0
  class s6 group0
  class s7 group0
  class s8 group0
  class s9 group0
  class s10 group3
  class s11 group0
  class s12 group0Fixed
  class s13 group0
  class s14 group2Fixed
  class s15 group0Fixed
  class s16 group0
  class s17 group2Fixed
  class s18 group3Fixed
  class s19 group1Fixed
